# Local dev environment — copy to .env.local and fill in cloud keys
# Switch VECTOR_STORE_PROVIDER to test each backend

# --- Core ---
GOOGLE_API_KEY=<your-google-api-key>
TAVILY_API_KEY=<your-tavily-api-key>
WEB_SEARCH_PROVIDER=tavily
EMBEDDING_PROVIDER=bge
CHUNK_STRATEGY=recursive
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Vector Store ---
VECTOR_STORE_PROVIDER=chromadb   # swap to: mongodb_atlas | pgvector | pinecone | elasticsearch

# pgvector — local Docker (docker-compose.local.yml port 5433)
PGVECTOR_DSN=postgresql+psycopg://postgres:postgres@localhost:5433/legal_advisor
PGVECTOR_COLLECTION_NAME=legal_documents_local

# Elasticsearch — local Docker (docker-compose.local.yml port 9200)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX_NAME=legal-advisor-local

# MongoDB Atlas — free-tier M0 cluster
MONGODB_ATLAS_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/
MONGODB_ATLAS_DB=legal_advisor_local
MONGODB_ATLAS_COLLECTION=legal_documents

# Pinecone — free Starter tier
PINECONE_API_KEY=<your-pinecone-api-key>
PINECONE_INDEX_NAME=legal-advisor-local

# --- Auth ---
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_WEBHOOK_SECRET=

# --- Database (Neon or local Postgres) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/legal_advisor

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=100

# --- Logging ---
LOG_LEVEL=DEBUG          # DEBUG for local dev; INFO for prod
LOG_TO_FILE=true
LOG_DIR=logs
LOG_MAX_BYTES=10485760   # 10 MB
LOG_BACKUP_COUNT=5
