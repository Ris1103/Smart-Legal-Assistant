# --- LLM / API Keys ---
GOOGLE_API_KEY=your_google_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here
TAVILY_API_KEY=                # for WEB_SEARCH_PROVIDER=tavily
GROK_API_KEY=                  # for WEB_SEARCH_PROVIDER=grok

# --- Service Config ---
FASTAPI_URL=http://localhost:8000
SERVICE_API_KEY=               # leave empty to disable auth in dev

# --- Storage ---
CHROMA_DB_PATH=                # defaults to app/chroma_db/ if left empty
CHROMA_COLLECTION_NAME=legal_documents

# --- Ingestion Limits ---
MAX_FILE_SIZE_MB=50

# --- HuggingFace Inference API ---
HF_API_KEY=                    # required when EMBEDDING_PROVIDER=hf_api or RERANKER_PROVIDER=hf_api

# --- Models ---
GENERATIVE_MODEL_NAME=gemma-4-26b-a4b-it
EMBEDDING_PROVIDER=google      # "google" | "bge" | "hf_api"
BGE_MODEL_NAME=BAAI/bge-m3
PERPLEXITY_MODEL_NAME=sonar
GROK_MODEL_NAME=grok-3

# --- Chunking ---
CHUNK_STRATEGY=recursive       # "recursive" | "semantic"
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Retrieval ---
SEMANTIC_WEIGHT=0.7
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_PROVIDER=bge          # "bge" (local FlagReranker) | "hf_api"
TOP_K_RETRIEVAL=8

# --- Context Compression ---
CONTEXT_COMPRESSION_ENABLED=false
COMPRESSION_SIMILARITY_THRESHOLD=0.5

# --- Evaluation ---
EVALUATION_FRAMEWORK=custom    # "custom" | "ragas"

# --- Web Search ---
WEB_SEARCH_PROVIDER=perplexity # "perplexity" | "tavily" | "grok"

# --- Vector Store (Phase 4) ---
VECTOR_STORE_PROVIDER=chromadb  # chromadb | mongodb_atlas | pgvector | pinecone

# MongoDB Atlas (M0 free tier)
MONGODB_ATLAS_URI=              # mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_ATLAS_DB=legal_advisor
MONGODB_ATLAS_COLLECTION=legal_documents

# pgvector on Neon (free tier)
PGVECTOR_DSN=                   # postgresql://user:pass@host/db

# Pinecone (free tier)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=legal-advisor

# --- MCP Integration (Phase 3) ---
MCP_ENABLED=false              # flip to true to activate MCP paths
MCP_SEARCH_SERVER_URL=http://localhost:8003
MCP_FILESYSTEM_SERVER_URL=http://localhost:8001
MCP_DATABASE_SERVER_URL=http://localhost:8002
