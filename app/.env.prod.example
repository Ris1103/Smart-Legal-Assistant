# Production environment — fill in managed cloud service credentials
# NEVER commit the filled-in .env.prod file

# --- Core ---
GOOGLE_API_KEY=<your-google-api-key>
TAVILY_API_KEY=<your-tavily-api-key>
WEB_SEARCH_PROVIDER=tavily
EMBEDDING_PROVIDER=bge
CHUNK_STRATEGY=recursive
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Vector Store ---
VECTOR_STORE_PROVIDER=chromadb   # swap to: mongodb_atlas | pgvector | pinecone | elasticsearch

# pgvector — Neon managed Postgres
PGVECTOR_DSN=postgresql+psycopg://neondb_owner:<pass>@<host>/neondb?sslmode=require
PGVECTOR_COLLECTION_NAME=legal_documents

# Elasticsearch — Elastic Cloud
ELASTICSEARCH_URL=https://<deployment-id>.es.elastic.cloud
ELASTICSEARCH_API_KEY=<base64-encoded-api-key>
ELASTICSEARCH_INDEX_NAME=legal-advisor-prod

# MongoDB Atlas — production cluster
MONGODB_ATLAS_URI=mongodb+srv://<user>:<pass>@<prod-cluster>.mongodb.net/
MONGODB_ATLAS_DB=legal_advisor
MONGODB_ATLAS_COLLECTION=legal_documents

# Pinecone — production index
PINECONE_API_KEY=<your-pinecone-api-key>
PINECONE_INDEX_NAME=legal-advisor-prod

# --- Auth ---
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_WEBHOOK_SECRET=whsec_...

# --- Database (Neon) ---
DATABASE_URL=postgresql+asyncpg://neondb_owner:<pass>@<host>/neondb?sslmode=require

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=10

# --- Logging ---
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=logs
LOG_MAX_BYTES=10485760   # 10 MB
LOG_BACKUP_COUNT=5
